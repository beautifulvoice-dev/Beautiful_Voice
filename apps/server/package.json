{
  "name": "@bv/server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/health.test.cjs test/conventions.test.cjs test/kakao-login.test.cjs test/owner-auth.test.cjs",
    "db:migrate": "node --env-file-if-exists=../../.env db/migrate.cjs",
    "db:register-local-owner": "pnpm run build && node --env-file-if-exists=../../.env db/register-local-owner.cjs",
    "db:test": "node --env-file-if-exists=../../.env --test test/database.test.cjs test/idempotency.test.cjs test/appointment.test.cjs test/m1-reference-data.test.cjs test/m1-appointment.test.cjs test/m1-settings.test.cjs test/m1-catalog.test.cjs test/m1-customers.test.cjs test/m1-customer-active.test.cjs test/m1-appointment-api.test.cjs"
  },
  "dependencies": {
    "@bv/contracts": "workspace:*",
    "@bv/customers": "workspace:*",
    "@bv/scheduling": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1"
  }
}
