# Docker Compose settings for local development
POSTGRES_DB=beautifulvoice
POSTGRES_USER=bv_local
POSTGRES_PASSWORD=bv_local_only
POSTGRES_PORT=5432
BV_LOCAL_APP_DB_PASSWORD=bv_app_local_only
DATABASE_URL=postgresql://bv_app_local:bv_app_local_only@127.0.0.1:5432/beautifulvoice
DATABASE_MIGRATION_URL=postgresql://bv_local:bv_local_only@127.0.0.1:5432/beautifulvoice

# Optional local Kakao login. Keep real credentials in .env only.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://127.0.0.1:5173/api/auth/kakao/callback
BV_SESSION_SECRET=
